# ===== TEDDY BEAR SHOP ENVIRONMENT CONFIGURATION =====
# Cấu hình môi trường cho website bán gấu bông

# Database Configuration
DB_HOST=localhost
DB_NAME=teddy_bear_shop
DB_USER=root
DB_PASS=

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/teddy-bear-shop

# Security Keys
JWT_SECRET=teddy-bear-secret-key-2024-change-this
ENCRYPTION_KEY=teddy-encryption-key-32characters

# Email Configuration  
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=noreply@teddyshop.com
MAIL_FROM_NAME=Teddy Bear Paradise

# Shipping & Fees
SHIPPING_FEE=30000
FREE_SHIPPING_MIN=500000
TAX_RATE=0.1

# File Upload Limits
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# Cache Settings
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Development only - Thay đổi khi deploy production
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=